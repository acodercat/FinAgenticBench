    "lagged_official_annual": {
      "description": "Latest official micro/annual release available by the cutoff, but it does not overlap 2024-2025 at the observation level; do not present it as contemporaneous 2024-2025 evidence.",
      "datasets": [
        "fed_scf"
      ],
      "latest_observation": {
        "fed_scf": "2022"
      }
    },
    "reference_crosswalk": {
